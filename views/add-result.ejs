<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Student Result | ResultShield</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{font-family:'DM Sans',sans-serif}
    h1,h2{font-family:'Manrope',sans-serif}
    body{background:#f5f6ff}
    .soft-card{box-shadow:0 16px 45px rgba(49,46,129,.08)}
    .field{width:100%;margin-top:8px;border:1px solid #e2e8f0;border-radius:12px;background:#f8fafc;padding:13px 14px;color:#1e293b;outline:none;transition:.2s}
    .field:focus{border-color:#818cf8;background:white;box-shadow:0 0 0 4px #e0e7ff}
    .field::placeholder{color:#94a3b8}
  </style>
</head>

<body class="min-h-screen text-slate-800">

  <nav class="border-b border-indigo-100 bg-white/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4">
      <a href="/admin" class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-600 text-xl font-extrabold text-white shadow-lg shadow-indigo-200">R</div>
        <div>
          <p class="text-lg font-extrabold tracking-tight text-slate-900">ResultShield</p>
          <p class="text-xs font-bold text-indigo-600">RESULT MANAGEMENT</p>
        </div>
      </a>
      <a href="/admin" class="rounded-xl border border-indigo-100 bg-indigo-50 px-4 py-2.5 text-sm font-bold text-indigo-700 transition hover:bg-indigo-100">← Admin Panel</a>
    </div>
  </nav>

  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-10">

    <div class="mb-6">
      <p class="text-xs font-extrabold uppercase tracking-[.22em] text-indigo-600">Student Records</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Add Student Result</h1>
      <p class="mt-3 text-sm leading-6 text-slate-500">Enter student details and subject marks to register a result.</p>
    </div>

    <div class="soft-card overflow-hidden rounded-3xl border border-indigo-100 bg-white">
      <div class="h-2 bg-gradient-to-r from-blue-600 via-indigo-600 to-violet-600"></div>

      <div class="p-5 sm:p-8">
        <div class="mb-7 flex items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-2xl text-indigo-600">▤</div>
          <div>
            <h2 class="text-lg font-extrabold text-slate-900">Student Information</h2>
            <p class="mt-1 text-sm text-slate-500">Fill in all required fields.</p>
          </div>
        </div>

        <form id="resultForm" class="space-y-7">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="text-sm font-bold text-slate-700">
              Student Name
              <input name="studentName" type="text" placeholder="Enter student name" autocomplete="name" required class="field">
            </label>

            <label class="text-sm font-bold text-slate-700">
              Roll Number
              <input name="rollNumber" type="text" placeholder="Enter roll number" required class="field">
            </label>

            <label class="text-sm font-bold text-slate-700">
              Course
              <input name="course" type="text" value="BCA" required class="field">
            </label>

            <label class="text-sm font-bold text-slate-700">
              Semester
              <select name="semester" required class="field">
                <option>Semester 1</option>
                <option>Semester 2</option>
                <option>Semester 3</option>
                <option>Semester 4</option>
                <option>Semester 5</option>
                <option>Semester 6</option>
              </select>
            </label>
          </div>

          <div class="border-t border-slate-100 pt-6">
            <div class="mb-5 flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-violet-50 text-xl text-violet-600">✎</div>
              <div>
                <h2 class="text-lg font-extrabold text-slate-900">Subject Marks</h2>
                <p class="mt-1 text-sm text-slate-500">Enter marks for each subject, out of 100.</p>
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <label class="text-sm font-bold text-slate-700">
                Computer Networks
                <input type="number" name="computerNetworks" min="0" max="100" step="1" placeholder="0 – 100" required class="field">
              </label>

              <label class="text-sm font-bold text-slate-700">
                Database
                <input type="number" name="database" min="0" max="100" step="1" placeholder="0 – 100" required class="field">
              </label>

              <label class="text-sm font-bold text-slate-700">
                Web Development
                <input type="number" name="webDevelopment" min="0" max="100" step="1" placeholder="0 – 100" required class="field">
              </label>

              <label class="text-sm font-bold text-slate-700">
                Java
                <input type="number" name="java" min="0" max="100" step="1" placeholder="0 – 100" required class="field">
              </label>

              <label class="text-sm font-bold text-slate-700 sm:col-span-2">
                Software Engineering
                <input type="number" name="softwareEngineering" min="0" max="100" step="1" placeholder="0 – 100" required class="field">
              </label>
            </div>
          </div>

          <div class="rounded-2xl border border-blue-100 bg-blue-50/70 p-4">
            <p class="text-sm font-bold text-blue-900">Before saving</p>
            <p class="mt-1 text-xs leading-5 text-blue-700">Check the roll number and marks carefully. Each subject accepts marks from 0 to 100.</p>
          </div>

          <p id="message" class="hidden rounded-xl border px-4 py-3 text-sm font-semibold" role="status" aria-live="polite"></p>

          <button id="submitBtn" type="submit" class="flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-violet-600 px-5 py-4 font-extrabold text-white shadow-lg shadow-indigo-200 transition hover:-translate-y-0.5 hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-60">
            Save Student Result <span>→</span>
          </button>

          <a href="/admin" class="block text-center text-sm font-bold text-slate-500 transition hover:text-indigo-700">Cancel and return to Admin Panel</a>
        </form>
      </div>
    </div>

    <footer class="py-6 text-center text-xs text-slate-400">
      ResultShield <span class="mx-1 text-indigo-300">•</span> Self-Healing Student Result System
    </footer>
  </main>

  <script>
    const form = document.getElementById('resultForm');
    const message = document.getElementById('message');
    const button = document.getElementById('submitBtn');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.textContent = 'Saving Student Result...';
      message.className = 'hidden';
      message.textContent = '';

      const data = new FormData(form);
      const payload = {
        studentName: data.get('studentName').trim(),
        rollNumber: data.get('rollNumber').trim(),
        course: data.get('course').trim(),
        semester: data.get('semester'),
        marks: {
          computerNetworks: data.get('computerNetworks'),
          database: data.get('database'),
          webDevelopment: data.get('webDevelopment'),
          java: data.get('java'),
          softwareEngineering: data.get('softwareEngineering')
        }
      };

      try {
        const response = await fetch('/api/admin/results', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Could not save result');

        message.className = 'block rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700';
        message.textContent = (result.message || 'Student result saved successfully') + ' — Roll Number: ' + (result.result?.rollNumber || payload.rollNumber);
        form.reset();
      } catch (error) {
        message.className = 'block rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700';
        message.textContent = error.message;
      } finally {
        button.disabled = false;
        button.innerHTML = 'Save Student Result <span>→</span>';
      }
    });
  </script>
</body>
</html>