
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ResultShield | Admin Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body{font-family:'DM Sans',sans-serif;background:#f5f7fb;color:#182230}
    h1,h2,h3{font-family:'Manrope',sans-serif}
    .card{background:white;border:1px solid #e8edf4;border-radius:16px}
    .table-wrap{overflow-x:auto}
    th,td{padding:14px 16px;text-align:left;white-space:nowrap;border-bottom:1px solid #edf0f5}
    th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#667085;background:#f8fafc}
    td{font-size:13px}
    .btn{padding:8px 12px;border-radius:8px;font-size:12px;font-weight:700}
  </style>
</head>
<body class="min-h-screen flex flex-col">

<header class="bg-white border-b border-slate-200">
  <div class="max-w-[1600px] mx-auto px-5 md:px-8 py-4 flex flex-wrap items-center justify-between gap-4">
    <a href="/admin" class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-xl bg-indigo-600 text-white grid place-items-center text-xl font-extrabold">R</div>
      <div>
        <h1 class="text-xl font-extrabold">ResultShield</h1>
        <p class="text-[10px] tracking-[.18em] text-slate-500 font-bold">ADMIN CONTROL CENTER</p>
      </div>
    </a>
    <nav class="flex items-center gap-5 text-sm font-semibold">
      <a href="/" class="text-slate-600 hover:text-indigo-600">Student Portal</a>
      <a href="/dashboard" class="text-slate-600 hover:text-indigo-600">Health Dashboard</a>
      <a href="/admin/logout" class="text-rose-600">Logout ↗</a>
    </nav>
  </div>
</header>

<main class="max-w-[1600px] w-full mx-auto px-5 md:px-8 py-8 flex-1">
  <section class="flex flex-wrap items-center justify-between gap-4 mb-7">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-indigo-600 mb-2">Control Center</p>
      <h2 class="text-3xl font-extrabold">Admin Dashboard</h2>
      <p class="text-slate-500 mt-2 text-sm">Manage student results and monitor your result portal.</p>
    </div>
    <a href="/admin/add-result" class="bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl px-5 py-3 font-bold text-sm">+ Add Student Result</a>
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
    <div class="card p-6">
      <p class="text-sm text-slate-500 font-semibold">Total Students</p>
      <h3 id="totalStudents" class="text-3xl font-extrabold mt-3">0</h3>
      <p class="text-xs text-slate-400 mt-2">Registered student records</p>
    </div>
    <div class="card p-6">
      <p class="text-sm text-slate-500 font-semibold">System Health</p>
      <h3 id="systemHealth" class="text-2xl font-extrabold text-emerald-600 mt-3">Checking...</h3>
      <p class="text-xs text-slate-400 mt-2">Current system status</p>
    </div>
    <div class="card p-6">
      <p class="text-sm text-slate-500 font-semibold">Student Portal</p>
      <h3 class="text-2xl font-extrabold text-emerald-600 mt-3">Active</h3>
      <a href="/dashboard" class="text-xs font-bold text-indigo-600 mt-3 inline-block">Open Health Dashboard →</a>
    </div>
  </section>

  <section class="card overflow-hidden">
    <div class="p-6 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h3 class="text-xl font-extrabold">Student Results</h3>
        <p class="text-sm text-slate-500 mt-1">View student details, subject-wise marks and final results.</p>
      </div>
      <input id="searchInput" type="search" placeholder="Search name or roll number..." class="border border-slate-200 rounded-xl px-4 py-3 text-sm outline-none focus:border-indigo-500 w-full sm:w-72">
    </div>

    <div id="message" class="hidden mx-6 mb-4 rounded-lg p-3 text-sm"></div>

    <div class="table-wrap">
      <table class="w-full">
        <thead>
          <tr>
            <th>Roll Number</th>
            <th>Student Name</th>
            <th>Course</th>
            <th>Semester</th>
            <th>Computer Networks</th>
            <th>Database</th>
            <th>Web Development</th>
            <th>Java</th>
            <th>Software Engineering</th>
            <th>Total / 500</th>
            <th>Percentage</th>
            <th>Grade</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="studentTable">
          <tr><td colspan="13" class="text-center py-10 text-slate-500">Loading student records...</td></tr>
        </tbody>
      </table>
    </div>
    <div class="p-5 text-xs text-slate-400" id="recordCount">Loading records...</div>
  </section>
</main>

<footer class="text-center text-xs text-slate-400 py-5">
  © 2026 ResultShield · Student Result Management System
</footer>

<script>
  let students = [];

  const table = document.getElementById('studentTable');
  const searchInput = document.getElementById('searchInput');
  const message = document.getElementById('message');

  function escapeHTML(value) {
    return String(value ?? '').replace(/[&<>"']/g, char => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[char]);
  }

  function getMarks(student) {
    const marks = student.marks || student;
    return [
      Number(marks.computerNetworks) || 0,
      Number(marks.database) || 0,
      Number(marks.webDevelopment) || 0,
      Number(marks.java) || 0,
      Number(marks.softwareEngineering) || 0
    ];
  }

  function getTotal(student) {
    return getMarks(student).reduce((sum, mark) => sum + mark, 0);
  }

  function getPercentage(student) {
    if (student.percentage !== undefined && student.percentage !== null) {
      return Number(student.percentage) || 0;
    }
    return getTotal(student) / 5;
  }

  function getGrade(student) {
    if (student.grade) return student.grade;
    const percentage = getPercentage(student);
    if (percentage >= 90) return 'A+';
    if (percentage >= 80) return 'A';
    if (percentage >= 70) return 'B+';
    if (percentage >= 60) return 'B';
    if (percentage >= 50) return 'C';
    if (percentage >= 40) return 'D';
    return 'F';
  }

  function showMessage(text, success = false) {
    message.textContent = text;
    message.className = 'mx-6 mb-4 rounded-lg p-3 text-sm ' +
      (success ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700');
  }

  function renderStudents() {
    const query = searchInput.value.trim().toLowerCase();

    const filtered = students.filter(student =>
      String(student.studentName || '').toLowerCase().includes(query) ||
      String(student.rollNumber || '').toLowerCase().includes(query)
    );

    document.getElementById('totalStudents').textContent = students.length;
    document.getElementById('recordCount').textContent =
      `Showing ${filtered.length} of ${students.length} student records`;

    if (!filtered.length) {
      table.innerHTML = '<tr><td colspan="13" class="text-center py-10 text-slate-500">No student records found.</td></tr>';
      return;
    }

    table.innerHTML = filtered.map(student => {
      const marks = getMarks(student);
      const total = getTotal(student);
      const percentage = getPercentage(student);
      const id = encodeURIComponent(student._id || '');

      return `
        <tr class="hover:bg-slate-50">
          <td class="font-bold text-indigo-700">${escapeHTML(student.rollNumber)}</td>
          <td class="font-bold">${escapeHTML(student.studentName)}</td>
          <td>${escapeHTML(student.course || 'BCA')}</td>
          <td>${escapeHTML(student.semester || '')}</td>
          ${marks.map(mark => `<td class="font-semibold">${mark}</td>`).join('')}
          <td class="font-extrabold">${total}/500</td>
          <td class="font-bold text-indigo-700">${percentage.toFixed(2)}%</td>
          <td><span class="rounded-lg bg-indigo-50 text-indigo-700 px-3 py-1 font-bold">${escapeHTML(getGrade(student))}</span></td>
          <td>
            <div class="flex gap-2">
              <a href="/admin/edit-result/${id}" class="btn bg-indigo-50 text-indigo-700">Edit</a>
              <button type="button" class="btn bg-rose-50 text-rose-600" onclick="deleteStudent('${escapeHTML(student._id)}')">Delete</button>
            </div>
          </td>
        </tr>`;
    }).join('');
  }

  async function loadStudents() {
    try {
      const response = await fetch('/api/admin/results');
      if (!response.ok) throw new Error('Could not load student records.');

      const data = await response.json();
      students = Array.isArray(data) ? data : (data.results || data.students || data.data || []);

      renderStudents();
    } catch (error) {
      table.innerHTML = '<tr><td colspan="13" class="text-center py-10 text-rose-600">Unable to load student records. Check the admin results API.</td></tr>';
      document.getElementById('recordCount').textContent = 'Failed to load records';
    }
  }

  async function loadHealth() {
    try {
      const response = await fetch('/api/health');
      const data = await response.json();
      const status = String(data.status || data.health || 'UNKNOWN').toUpperCase();
      const element = document.getElementById('systemHealth');
      element.textContent = status;
      element.className = 'text-2xl font-extrabold mt-3 ' +
        (status === 'HEALTHY' ? 'text-emerald-600' : 'text-amber-600');
    } catch {
      document.getElementById('systemHealth').textContent = 'UNKNOWN';
    }
  }

  async function deleteStudent(id) {
    if (!id || !confirm('Are you sure you want to delete this student result?')) return;

    try {
      const response = await fetch('/api/admin/results/' + encodeURIComponent(id), {
        method: 'DELETE'
      });

      if (!response.ok) throw new Error('Delete failed. Check your delete API route.');

      showMessage('Student result deleted successfully.', true);
      await loadStudents();
    } catch (error) {
      showMessage(error.message || 'Unable to delete student result.');
    }
  }

  searchInput.addEventListener('input', renderStudents);

  loadStudents();
  loadHealth();
</script>
</body>
</html>
