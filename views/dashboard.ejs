      <b id="recoveries" class="mt-4 block text-3xl font-extrabold text-blue-700">—</b>
      <p class="mt-2 text-xs text-slate-400">Recovery actions completed</p>
    </div>
    <div class="soft-card rounded-2xl border border-indigo-100 bg-white p-5 transition hover:-translate-y-1">
      <div class="flex items-center justify-between"><p class="text-sm font-bold text-slate-500">Requests Handled</p><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-xl text-indigo-600">⇄</span></div>
      <b id="requests" class="mt-4 block text-3xl font-extrabold text-indigo-700">—</b>
      <p class="mt-2 text-xs text-slate-400">Requests processed by app</p>
    </div>
    <div class="soft-card rounded-2xl border border-violet-100 bg-white p-5 transition hover:-translate-y-1">
      <div class="flex items-center justify-between"><p class="text-sm font-bold text-slate-500">Cached Results</p><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50 text-xl text-violet-600">▤</span></div>
      <b id="cache" class="mt-4 block text-3xl font-extrabold text-violet-700">—</b>
      <p class="mt-2 text-xs text-slate-400">Results available in cache</p>
    </div>
    <div class="soft-card rounded-2xl border border-emerald-100 bg-white p-5 transition hover:-translate-y-1">
      <div class="flex items-center justify-between"><p class="text-sm font-bold text-slate-500">App Uptime</p><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600">◷</span></div>
      <b id="uptime" class="mt-4 block text-3xl font-extrabold text-emerald-700">—</b>
