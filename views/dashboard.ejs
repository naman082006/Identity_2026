  <p id="lastError" class="mt-4 text-sm font-semibold text-rose-600" role="status"></p>

  <footer class="mt-10 border-t border-indigo-100 py-6 text-center text-xs text-slate-400">
    ResultShield <span class="mx-1 text-indigo-300">•</span> Self-Healing Student Result System
  </footer>
</main>

<script>
const statusStyles = {
  healthy: 'border-emerald-200 bg-emerald-50 text-emerald-700',
  degraded: 'border-amber-200 bg-amber-50 text-amber-700',
  down: 'border-rose-200 bg-rose-50 text-rose-700'
};

function escapeHtml(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[c]));
}

function numberValue(value) {
  const n = Number(value);
  return Number.isFinite(n) ? n.toLocaleString() : '0';
}

function formatUptime(value) {
  const total = Math.max(0, Number(value) || 0);
  const hours = Math.floor(total / 3600);
  const minutes = Math.floor((total % 3600) / 60);
  const seconds = Math.floor(total % 60);
  if (hours) return `${hours}h ${minutes}m`;
  if (minutes) return `${minutes}m ${seconds}s`;
  return `${seconds}s`;
}

async function refresh() {
  const overall = document.getElementById('overall');

  try {
    const response = await fetch('/api/health', { cache: 'no-store' });
    if (!response.ok) throw new Error(`Health API returned HTTP ${response.status}`);

    const d = await response.json();
    if (!d || typeof d !== 'object') throw new Error('Invalid health response');

    const healingBanner = document.getElementById('autoHealingBanner');

    if (d.applicationDown) {
      healingBanner.classList.remove('hidden');
      document.getElementById('autoHealingDetail').textContent =
        'Application outage is active. Click Heal System to restore access.';
    } else if (d.autoFailureActive) {
      healingBanner.classList.remove('hidden');
      document.getElementById('autoHealingDetail').textContent =
        `Recovering from ${d.autoFailureType || 'system'} failure.`;
    } else {
      healingBanner.classList.add('hidden');
    }

    const overallStatus = d.applicationDown
      ? 'down'
      : String(d.overall || 'degraded').toLowerCase();

    overall.textContent = overallStatus === 'healthy'
      ? '● All systems operational'
      : overallStatus === 'down'
        ? '● System unavailable'
        : '● Degraded — check components';

    overall.className = 'w-fit rounded-full border px-4 py-2.5 text-sm font-bold ' +
      (statusStyles[overallStatus] || statusStyles.degraded);

    document.getElementById('recoveries').textContent = numberValue(d.recoveries);
    document.getElementById('requests').textContent = numberValue(d.requestCount ?? d.requestsHandled);
    document.getElementById('cache').textContent = numberValue(d.cacheEntries ?? d.cachedResults);
    document.getElementById('uptime').textContent = formatUptime(d.uptimeSeconds);
    document.getElementById('limits').textContent = numberValue(d.rateLimitEvents);

    const components = Array.isArray(d.components) ? d.components : [];

    document.getElementById('components').innerHTML = components.length
      ? components.map(c => {
          let status = String(c.status || 'degraded').toLowerCase();

          if (d.applicationDown && String(c.name || '').toLowerCase() === 'application') {
            status = 'down';
          }

          const badge = statusStyles[status] || statusStyles.degraded;
          const icon = status === 'healthy' ? '✓' : status === 'down' ? '!' : '⚠';
          const iconStyle = status === 'healthy'
            ? 'bg-emerald-50 text-emerald-700'
            : status === 'down'
              ? 'bg-rose-50 text-rose-700'
              : 'bg-amber-50 text-amber-700';

          return `<article class="soft-card rounded-2xl border border-indigo-100 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg">
            <div class="flex items-start justify-between gap-3">
              <div class="flex min-w-0 items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ${iconStyle} text-lg font-extrabold">${icon}</span>
                <b class="break-words text-sm font-extrabold text-slate-800">${escapeHtml(c.name || 'Unknown component')}</b>
              </div>
              <span class="shrink-0 rounded-full border px-2.5 py-1 text-[10px] font-extrabold tracking-wide ${badge}">${escapeHtml(status.toUpperCase())}</span>
            </div>
            <p class="mt-4 text-sm leading-6 text-slate-500">${escapeHtml(d.applicationDown && String(c.name || '').toLowerCase() === 'application' ? 'Controlled outage active. Heal System is required.' : c.detail || 'No details available')}</p>
          </article>`;
        }).join('')
      : '<p class="rounded-2xl border border-slate-200 bg-white p-5 text-sm text-slate-500">No component data returned by the health API.</p>';

    const incidents = Array.isArray(d.incidents) ? d.incidents : [];

    document.getElementById('incidents').innerHTML = incidents.length
      ? incidents.map(i => `<tr class="border-b border-slate-100 align-top transition hover:bg-indigo-50/60">
          <td class="whitespace-nowrap p-4 text-slate-500">${escapeHtml(i.time ? new Date(i.time).toLocaleTimeString() : '—')}</td>
          <td class="p-4 font-bold text-slate-800">${escapeHtml(i.component || 'Unknown')}</td>
          <td class="p-4"><span class="inline-block rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700">${escapeHtml(i.status || '—')}</span></td>
          <td class="p-4 leading-6 text-slate-600">${escapeHtml(i.message || '')}</td>
        </tr>`).join('')
      : '<tr><td colspan="4" class="p-6 text-center text-slate-400">No incidents recorded yet.</td></tr>';

    document.getElementById('lastError').textContent =
      d.lastError ? 'Latest application error: ' + d.lastError : '';
  } catch (error) {
    overall.textContent = '● Dashboard disconnected';
    overall.className = 'w-fit rounded-full border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-bold text-rose-700';
    document.getElementById('lastError').textContent =
      'Health check failed: ' + error.message;
  }
}

async function chaos(type) {
  const out = document.getElementById('chaosMessage');
  out.textContent = 'Applying ' + type + '...';

  try {
    const r = await fetch('/api/chaos/' + encodeURIComponent(type), {
      method: 'POST',
      cache: 'no-store'
    });

    const d = await r.json().catch(() => ({}));

    if (!r.ok) throw new Error(d.error || d.message || `HTTP ${r.status}`);

    out.textContent = d.message || `Completed: ${type}`;
    await refresh();
  } catch (e) {
    out.textContent = 'Request failed: ' + e.message;
  }
}

async function checkExternal() {
  const out = document.getElementById('chaosMessage');
  out.textContent = 'Checking external service...';

  try {
    const r = await fetch('/api/external-check', { cache: 'no-store' });
    const d = await r.json().catch(() => ({}));

    out.textContent = r.ok
      ? (d.message || 'External service check completed.')
      : (d.error || d.message || `HTTP ${r.status}`) +
        ' — circuit ' + (d.circuitOpen ? 'OPEN' : 'not open yet');

    await refresh();
  } catch (e) {
    out.textContent = 'External check failed: ' + e.message;
  }
}

async function trafficBurst() {
  const out = document.getElementById('chaosMessage');

  if (!confirm('Activate the Traffic Burst failure? The Student Portal will become temporarily unavailable.')) {
  return;
}

  out.textContent = 'Activating controlled application outage...';

  try {
    const r = await fetch('/api/chaos/traffic-burst', {
      method: 'POST',
      cache: 'no-store'
    });

    const d = await r.json().catch(() => ({}));

    if (!r.ok) throw new Error(d.error || d.message || `HTTP ${r.status}`);

    out.textContent = d.message || 'Application outage activated. Click Heal System to recover.';
    await refresh();
  } catch (e) {
    out.textContent = 'Traffic Burst failed: ' + e.message;
  }
}

async function healSystem() {
  const out = document.getElementById('chaosMessage');
  const button = document.getElementById('healButton');

  button.disabled = true;
  out.textContent = 'Healing system and restoring application...';

  try {
    const r = await fetch('/api/chaos/traffic-restore', {
      method: 'POST',
      cache: 'no-store'
    });

    const d = await r.json().catch(() => ({}));

    if (!r.ok) throw new Error(d.error || d.message || `HTTP ${r.status}`);

    out.textContent = d.message || 'Application restored successfully.';
    await refresh();
  } catch (e) {
    out.textContent = 'Heal failed: ' + e.message;
  } finally {
    button.disabled = false;
  }
}

async function loadTest() {
  const out = document.getElementById('chaosMessage');
  const button = document.getElementById('trafficButton');

  button.disabled = true;
  out.textContent = 'Sending 80 parallel requests and measuring HTTP responses...';

  const start = performance.now();

  try {
    const results = await Promise.allSettled(
      Array.from({ length: 80 }, () =>
        fetch('/api/chaos/traffic', { method: 'GET', cache: 'no-store' })
      )
    );

    const elapsed = Math.round(performance.now() - start);
    let successful = 0;
    let blocked = 0;
    let otherErrors = 0;

    for (const result of results) {
      if (result.status === 'rejected') {
        otherErrors++;
      } else if (result.value.status === 429) {
        blocked++;
      } else if (result.value.ok) {
        successful++;
      } else {
        otherErrors++;
      }
    }

    document.getElementById('burstSuccess').textContent = successful;
    document.getElementById('burstBlocked').textContent = blocked;
    document.getElementById('burstErrors').textContent = otherErrors;
    document.getElementById('burstTime').textContent = elapsed + ' ms';

    out.textContent =
      `Traffic test completed: ${successful} successful, ${blocked} rate-limited, ${otherErrors} other/network errors, in ${elapsed} ms.`;

    await refresh();
  } catch (e) {
    out.textContent = 'Traffic test failed: ' + e.message;
  } finally {
    button.disabled = false;
  }
}

async function crashApp() {
  if (!confirm('This will terminate the app process. Continue only if PM2 is managing ResultShield.')) return;

  try {
    const r = await fetch('/api/chaos/crash', { method: 'POST' });
    const d = await r.json().catch(() => ({}));

    document.getElementById('chaosMessage').textContent =
      d.message || 'Process may be restarting. Refresh after a few seconds.';
  } catch (e) {
    document.getElementById('chaosMessage').textContent =
      'Process may be restarting. Refresh after a few seconds.';
  }
}

refresh();
setInterval(refresh, 2000);
</script>

