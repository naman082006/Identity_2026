<body class="min-h-screen text-slate-800">

<nav class="sticky top-0 z-20 border-b border-indigo-100 bg-white/90 backdrop-blur-xl">
  <div class="flex w-full flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:px-12">
    <a href="/" class="flex items-center gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-600 text-xl font-extrabold text-white shadow-lg shadow-indigo-200">R</div>
      <div>
        <h1 class="text-xl font-extrabold tracking-tight text-slate-900">ResultShield</h1>
