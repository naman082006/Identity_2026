      <button onclick="chaos('external-on')" class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-rose-300 hover:shadow-md">
        <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-rose-100 text-xl text-rose-700">!</span>
        <b class="block text-sm text-slate-800">2. Fail External Service</b>
        <small class="mt-1 block leading-5 text-slate-500">Simulate an external service timeout.</small>
      </button>

      <!-- <button onclick="checkExternal()" class="rounded-2xl border border-blue-200 bg-blue-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md">
        <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 text-xl text-blue-700">↗</span>
        <b class="block text-sm text-slate-800">Call External Service</b>
        <small class="mt-1 block leading-5 text-slate-500">Test external service availability.</small>
      </button> -->

      <button onclick="chaos('external-off')" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md">
        <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-xl text-emerald-700">✓</span>
        <b class="block text-sm text-slate-800">Restore External Service</b>
        <small class="mt-1 block leading-5 text-slate-500">Clear the simulated service failure.</small>
      </button>

      <button onclick="chaos('result-hang-on')" class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md">
        <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-xl text-amber-700">◷</span>
        <b class="block text-sm text-slate-800">5. Simulate Result Loading Hang</b>
        <small class="mt-1 block leading-5 text-slate-500">Activate the result loading failure.</small>
      </button>

      <button onclick="chaos('result-hang-off')" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md">
        <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-xl text-emerald-700">✓</span>
        <b class="block text-sm text-slate-800">Restore Result Loading</b>
        <small class="mt-1 block leading-5 text-slate-500">Remove the loading failure simulation.</small>
      </button>

      <button id="trafficButton" onclick="trafficBurst()" class="rounded-2xl border border-indigo-200 bg-indigo-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md">
        <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-100 text-xl text-indigo-700">⚡</span>
        <b class="block text-sm text-slate-800">3. Traffic Burst Test</b>
        <small class="mt-1 block leading-5 text-slate-500">Simulate an application outage.</small>
      </button>

      <button id="healButton" onclick="healSystem()" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md">
