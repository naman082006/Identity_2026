      </div>
      <div class="rounded-2xl border border-rose-100 bg-rose-50/70 p-4">
        <p class="text-sm font-semibold text-slate-500">Other HTTP Errors</p>
        <b id="burstErrors" class="mt-2 block text-2xl font-extrabold text-rose-700">—</b>
      </div>
      <div class="rounded-2xl border border-blue-100 bg-blue-50/70 p-4">
        <p class="text-sm font-semibold text-slate-500">Test Duration</p>
        <b id="burstTime" class="mt-2 block text-2xl font-extrabold text-blue-700">—</b>
      </div>
    </div>
    <p class="mt-3 text-xs leading-5 text-slate-400">Burst results show the latest test. HTTP 429 means a request was rate-limited.</p>
  </section>

  <section class="mt-9">
    <div class="mb-4">
      <p class="text-xs font-extrabold uppercase tracking-[.2em] text-indigo-600">System Activity</p>
      <h2 class="mt-1 text-2xl font-extrabold text-slate-900">Incident Timeline</h2>
      <p class="mt-1 text-sm text-slate-500">Detection, diagnosis and recovery events.</p>
    </div>
    <div class="soft-card overflow-hidden rounded-2xl border border-indigo-100 bg-white">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[700px] text-left text-sm">
          <thead class="border-b border-slate-100 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="p-4 font-extrabold">Time</th>
              <th class="p-4 font-extrabold">Component</th>
              <th class="p-4 font-extrabold">Stage</th>
              <th class="p-4 font-extrabold">Incident Details</th>
            </tr>
          </thead>
          <tbody id="incidents">
            <tr><td colspan="4" class="p-6 text-center text-slate-400">Loading incidents...</td></tr>
          </tbody>
