      <div>
        <p class="font-extrabold text-blue-900">Failure Detected — Recovery Required</p>
        <p id="autoHealingDetail" class="mt-1 text-sm leading-6 text-blue-700">Use Heal System to restore the application.</p>
      </div>
    </div>
  </section>

  <section class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    <div class="soft-card rounded-2xl border border-blue-100 bg-white p-5 transition hover:-translate-y-1">
