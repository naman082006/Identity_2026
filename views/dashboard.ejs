</nav>

<main class="w-full px-4 py-6 sm:px-8 sm:py-10 lg:px-12 xl:px-16">

  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-blue-700 via-indigo-600 to-violet-600 p-6 text-white shadow-xl shadow-indigo-200 sm:p-10 lg:p-12">
    <div class="pointer-events-none absolute -right-10 -top-20 h-60 w-60 rounded-full bg-white/10 blur-2xl"></div>
    <div class="relative flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-blue-50">
          <span class="h-2 w-2 rounded-full bg-emerald-300"></span> Reliability Control Room
        </span>
