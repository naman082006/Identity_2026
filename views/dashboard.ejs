  <section class="soft-card mt-9 rounded-3xl border border-indigo-100 bg-white p-5 sm:p-7">
    <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[.2em] text-violet-600">Failure Simulation Lab</p>
        <h2 class="mt-1 text-2xl font-extrabold text-slate-900">Chaos Lab</h2>
        <p class="mt-2 text-sm text-slate-500">Trigger controlled failures and observe detection and recovery.</p>
      </div>
      <span class="w-fit rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-700">Local Demo Only</span>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">

      <button onclick="chaos('database-on')" class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md">
        <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-xl text-amber-700">⚠</span>
        <b class="block text-sm text-slate-800">1. Simulate Database Failure</b>
        <small class="mt-1 block leading-5 text-slate-500">Disable result database reads.</small>
      </button>

      <button onclick="chaos('database-off')" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md">
        <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-xl text-emerald-700">✓</span>
        <b class="block text-sm text-slate-800">Restore Database</b>
